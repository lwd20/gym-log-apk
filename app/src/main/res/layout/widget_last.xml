<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bgimg"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wg_bg"
        android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/content"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
   
    android:paddingLeft="16dp" android:paddingRight="16dp"
    android:paddingTop="12dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/root_hd"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="LAST WEIGHTS" android:textSize="11sp" android:textStyle="bold"
            android:letterSpacing="0.28" android:textColor="#9A8A63"/>
        <TextView android:id="@+id/root_cnt"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textStyle="bold" android:textColor="#5C5648"/>
    </LinearLayout>
    <TextView android:id="@+id/root_empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:textSize="13.5sp" android:textColor="#6E675B"
        android:visibility="gone"/>
    <LinearLayout android:id="@+id/lwrow0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
        <TextView android:id="@+id/lwn0"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:id="@+id/lwv0"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:id="@+id/lws0"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/lwrow1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
        <TextView android:id="@+id/lwn1"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:id="@+id/lwv1"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:id="@+id/lws1"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/lwrow2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
        <TextView android:id="@+id/lwn2"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:id="@+id/lwv2"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:id="@+id/lws2"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/lwrow3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
        <TextView android:id="@+id/lwn3"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:id="@+id/lwv3"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:id="@+id/lws3"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/lwrow4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
        <TextView android:id="@+id/lwn4"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:id="@+id/lwv4"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:id="@+id/lws4"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/lwrow5" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
        <TextView android:id="@+id/lwn5"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:id="@+id/lwv5"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:id="@+id/lws5"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
</LinearLayout>
</FrameLayout>

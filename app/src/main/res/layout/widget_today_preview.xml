<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:background="@drawable/wg_bg"
    android:paddingLeft="16dp" android:paddingRight="16dp"
    android:paddingTop="12dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="TODAY" android:textSize="11sp" android:textStyle="bold"
            android:letterSpacing="0.28" android:textColor="#9A8A63"/>
        <TextView android:text="5"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textStyle="bold" android:textColor="#5C5648"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="13.5sp" android:textColor="#6E675B"
        android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:text="Chest Press"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:text="50x13"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:text="3세트"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:text="Incline Press"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:text="45x12"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:text="3세트"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:text="Pec Deck Fly"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:text="41x12"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:text="3세트"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:text="Neck Press"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:text="15x12"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:text="3세트"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:text="Lateral Raise"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:text="41x12"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:text="4세트"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:visibility="gone"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="14.5sp" android:textStyle="bold" android:textColor="#C9BFA8"/>
        <TextView android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#E3B95A"/>
        <TextView android:visibility="gone"
            android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="13sp" android:textColor="#8F887C"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/wg_bg"
    android:paddingLeft="16dp" android:paddingRight="16dp"
    android:paddingTop="12dp" android:paddingBottom="13dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="WEEKLY SETS" android:textSize="11sp" android:textStyle="bold"
        android:letterSpacing="0.28" android:textColor="#9A8A63"/>
    <TextView android:text="가슴 15/15"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08"
        android:textColor="#C9BFA8" android:layout_marginTop="8dp"/>
    <ProgressBar android:progress="100" android:max="100"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="7dp"
        android:layout_marginTop="3dp"
        android:progressDrawable="@drawable/wg_bar"/>
    <TextView android:text="등 18/20"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08"
        android:textColor="#C9BFA8" android:layout_marginTop="6dp"/>
    <ProgressBar android:progress="90" android:max="100"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="7dp"
        android:layout_marginTop="3dp"
        android:progressDrawable="@drawable/wg_bar"/>
    <TextView android:text="어깨 20/20"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08"
        android:textColor="#C9BFA8" android:layout_marginTop="6dp"/>
    <ProgressBar android:progress="100" android:max="100"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="7dp"
        android:layout_marginTop="3dp"
        android:progressDrawable="@drawable/wg_bar"/>
    <TextView android:text="하체 12/15"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08"
        android:textColor="#C9BFA8" android:layout_marginTop="6dp"/>
    <ProgressBar android:progress="80" android:max="100"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="7dp"
        android:layout_marginTop="3dp"
        android:progressDrawable="@drawable/wg_bar"/>
    <TextView android:text="팔 9/14"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08"
        android:textColor="#C9BFA8" android:layout_marginTop="6dp"/>
    <ProgressBar android:progress="64" android:max="100"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="7dp"
        android:layout_marginTop="3dp"
        android:progressDrawable="@drawable/wg_bar"/>
    <TextView android:text="유산소 60/90"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08"
        android:textColor="#C9BFA8" android:layout_marginTop="6dp"/>
    <ProgressBar android:progress="67" android:max="100"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="7dp"
        android:layout_marginTop="3dp"
        android:progressDrawable="@drawable/wg_bar"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wg_bg"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp" android:paddingRight="16dp"
        android:paddingTop="12dp" android:paddingBottom="13dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end"
                android:text="NEXT UP" android:textSize="11sp" android:textStyle="bold"
                android:letterSpacing="0.28" android:textColor="#9A8A63"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="9dp">
            <TextView
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:text="어깨"
                android:maxLines="1" android:ellipsize="end"
                android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.02" android:textColor="#E3B95A"/>
            <TextView
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginLeft="6dp"
                android:text="4일 안 함 · 6/16세트"
                android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:letterSpacing="0.02" android:textColor="#8F887C"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="7dp">
            <TextView
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:text="등"
                android:maxLines="1" android:ellipsize="end"
                android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.02" android:textColor="#E3B95A"/>
            <TextView
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginLeft="6dp"
                android:text="3일 안 함 · 8/14세트"
                android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:letterSpacing="0.02" android:textColor="#8F887C"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="7dp">
            <TextView
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:text="하체"
                android:maxLines="1" android:ellipsize="end"
                android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.02" android:textColor="#E3B95A"/>
            <TextView
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginLeft="6dp"
                android:text="2일 안 함 · 10/14세트"
                android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:letterSpacing="0.02" android:textColor="#8F887C"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="12sp" android:letterSpacing="0.02" android:textColor="#8F887C"/>
    </LinearLayout>
</FrameLayout>

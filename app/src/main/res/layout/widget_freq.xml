<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bgimg"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/wg_bg"
        android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/content"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="top"
        android:paddingLeft="16dp" android:paddingRight="16dp"
        android:paddingTop="12dp" android:paddingBottom="13dp">
        <TextView android:id="@+id/fhd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SESSIONS / WEEK"
            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
            android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.28" android:textColor="#9A8A63"/>
        <LinearLayout android:id="@+id/frow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/fcol0"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/fl0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="11sp" android:textStyle="bold" android:textColor="#9A8A63"/>
                <TextView android:id="@+id/fc0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="21sp" android:textStyle="bold" android:textColor="#E3B95A"/>
                <ProgressBar android:id="@+id/fb0"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:progressDrawable="@drawable/wg_bar"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/fcol1"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/fl1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="11sp" android:textStyle="bold" android:textColor="#9A8A63"/>
                <TextView android:id="@+id/fc1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="21sp" android:textStyle="bold" android:textColor="#E3B95A"/>
                <ProgressBar android:id="@+id/fb1"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:progressDrawable="@drawable/wg_bar"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/fcol2"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/fl2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="11sp" android:textStyle="bold" android:textColor="#9A8A63"/>
                <TextView android:id="@+id/fc2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="21sp" android:textStyle="bold" android:textColor="#E3B95A"/>
                <ProgressBar android:id="@+id/fb2"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:progressDrawable="@drawable/wg_bar"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/fcol3"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/fl3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="11sp" android:textStyle="bold" android:textColor="#9A8A63"/>
                <TextView android:id="@+id/fc3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="21sp" android:textStyle="bold" android:textColor="#E3B95A"/>
                <ProgressBar android:id="@+id/fb3"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:progressDrawable="@drawable/wg_bar"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/fcol4"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/fl4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="11sp" android:textStyle="bold" android:textColor="#9A8A63"/>
                <TextView android:id="@+id/fc4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="21sp" android:textStyle="bold" android:textColor="#E3B95A"/>
                <ProgressBar android:id="@+id/fb4"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:progressDrawable="@drawable/wg_bar"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/fcol5"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/fl5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="11sp" android:textStyle="bold" android:textColor="#9A8A63"/>
                <TextView android:id="@+id/fc5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                    android:textSize="21sp" android:textStyle="bold" android:textColor="#E3B95A"/>
                <ProgressBar android:id="@+id/fb5"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:progressDrawable="@drawable/wg_bar"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/ffoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:visibility="gone"
            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
            android:textSize="11sp" android:textColor="#8F887C"/>
    </LinearLayout>
</FrameLayout>

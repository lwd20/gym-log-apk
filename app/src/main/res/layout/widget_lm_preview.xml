<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/wg_bg"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical"
        android:paddingLeft="14dp" android:paddingRight="14dp"
        android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="VOLUME LANDMARKS" android:textSize="11sp" android:textStyle="bold"
            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
            android:letterSpacing="0.28" android:textColor="#9A8A63"/>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:layout_width="46dp" android:layout_height="wrap_content"
                android:text="어깨"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:textStyle="bold" android:textColor="#9A8A63"/>
            <FrameLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="10dp" android:clipChildren="true">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="8dp" android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/wg_lm_track">
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="120"
                        android:layout_height="match_parent"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="60"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z1"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="60"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z2"/>
                    <FrameLayout
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_tick"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="20"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z2"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="39"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="105dp">
                    <ImageView
                        android:layout_width="8dp" android:layout_height="8dp"
                        android:src="@drawable/wg_lm_dot"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
            </FrameLayout>
            <TextView android:text="18"
                android:layout_height="wrap_content"
                android:layout_width="22dp" android:gravity="end"
                android:layout_marginStart="6dp" android:layout_marginLeft="6dp"
                android:includeFontPadding="false" android:maxLines="1"
                android:fontFamily="monospace"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#8F887C"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:layout_width="46dp" android:layout_height="wrap_content"
                android:text="등"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:textStyle="bold" android:textColor="#9A8A63"/>
            <FrameLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="10dp" android:clipChildren="true">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="8dp" android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/wg_lm_track">
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="100"
                        android:layout_height="match_parent"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="40"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z1"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="60"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z2"/>
                    <FrameLayout
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_tick"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="20"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z2"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="33"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="94dp">
                    <ImageView
                        android:layout_width="8dp" android:layout_height="8dp"
                        android:src="@drawable/wg_lm_dot"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
            </FrameLayout>
            <TextView android:text="16"
                android:layout_height="wrap_content"
                android:layout_width="22dp" android:gravity="end"
                android:layout_marginStart="6dp" android:layout_marginLeft="6dp"
                android:includeFontPadding="false" android:maxLines="1"
                android:fontFamily="monospace"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#8F887C"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:layout_width="46dp" android:layout_height="wrap_content"
                android:text="가슴"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:textStyle="bold" android:textColor="#9A8A63"/>
            <FrameLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="10dp" android:clipChildren="true">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="8dp" android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/wg_lm_track">
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="80"
                        android:layout_height="match_parent"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="40"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z1"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="60"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z2"/>
                    <FrameLayout
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_tick"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="20"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z2"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="30"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="100dp">
                    <ImageView
                        android:layout_width="8dp" android:layout_height="8dp"
                        android:src="@drawable/wg_lm_dot"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
            </FrameLayout>
            <TextView android:text="15"
                android:layout_height="wrap_content"
                android:layout_width="22dp" android:gravity="end"
                android:layout_marginStart="6dp" android:layout_marginLeft="6dp"
                android:includeFontPadding="false" android:maxLines="1"
                android:fontFamily="monospace"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#8F887C"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:layout_width="46dp" android:layout_height="wrap_content"
                android:text="하체"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:textStyle="bold" android:textColor="#9A8A63"/>
            <FrameLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="10dp" android:clipChildren="true">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="8dp" android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/wg_lm_track">
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="100"
                        android:layout_height="match_parent"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="40"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z1"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="70"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z2"/>
                    <FrameLayout
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_tick"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="10"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z2"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="33"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="81dp">
                    <ImageView
                        android:layout_width="8dp" android:layout_height="8dp"
                        android:src="@drawable/wg_lm_dot"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
            </FrameLayout>
            <TextView android:text="12"
                android:layout_height="wrap_content"
                android:layout_width="22dp" android:gravity="end"
                android:layout_marginStart="6dp" android:layout_marginLeft="6dp"
                android:includeFontPadding="false" android:maxLines="1"
                android:fontFamily="monospace"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#8F887C"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:layout_width="46dp" android:layout_height="wrap_content"
                android:text="팔·기타"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:textSize="11sp" android:textStyle="bold" android:textColor="#9A8A63"/>
            <FrameLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="10dp" android:clipChildren="true">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="8dp" android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/wg_lm_track">
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="80"
                        android:layout_height="match_parent"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="40"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z1"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="60"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_z2"/>
                    <FrameLayout
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/wg_lm_tick"/>
                    <FrameLayout
                        android:layout_width="0dp" android:layout_weight="27"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="75dp">
                    <ImageView
                        android:layout_width="8dp" android:layout_height="8dp"
                        android:src="@drawable/wg_lm_dot"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
            </FrameLayout>
            <TextView android:text="9"
                android:layout_height="wrap_content"
                android:layout_width="22dp" android:gravity="end"
                android:layout_marginStart="6dp" android:layout_marginLeft="6dp"
                android:includeFontPadding="false" android:maxLines="1"
                android:fontFamily="monospace"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#8F887C"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
            android:text="눈금 = 감량 보정 MRV"
            android:textSize="10sp" android:textColor="#8F887C"/>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wg_bg"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="16dp" android:paddingRight="16dp"
        android:paddingTop="12dp" android:paddingBottom="13dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="CUT" android:textSize="11sp" android:textStyle="bold"
                android:letterSpacing="0.28" android:textColor="#9A8A63"/>
            <TextView
                android:text="D-42"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="17sp" android:textStyle="bold"
                android:letterSpacing="0.02" android:textColor="#E3B95A"/>
        </LinearLayout>

        <TextView
            android:text="78.2 → 72.5 kg"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:textSize="15sp" android:textStyle="bold" android:letterSpacing="0.02"
            android:maxLines="1" android:ellipsize="end"
            android:textColor="#C9BFA8"/>

        <ProgressBar
            android:max="100" android:progress="62"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="7dp"
            android:layout_marginTop="7dp"
            android:progressDrawable="@drawable/wg_bar"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:text="실측 -0.45 · 목표 -0.5 kg/주"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="11sp" android:letterSpacing="0.02"
                android:maxLines="1" android:ellipsize="end"
                android:textColor="#8F887C"/>
            <TextView
                android:text="페이스 양호"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:layout_marginLeft="8dp"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.02"
                android:maxLines="1"
                android:textColor="#8F887C"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
